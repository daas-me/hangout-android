<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image Section with Format Badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/ivEventImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/event_image_gradient" />

            <!-- Format Badge -->
            <TextView
                android:id="@+id/tvEventFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In-Person"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:fontFamily="@font/dm_sans"
                android:background="@drawable/btn_pill_purple"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp" />
        </FrameLayout>

        <!-- Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/syne_bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="12dp" />

            <!-- Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/purple_main"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/dm_sans" />
            </LinearLayout>

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/purple_main"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/dm_sans"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Attendees -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_users"
                    app:tint="@color/purple_main"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvAttendees"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/dm_sans" />
            </LinearLayout>

            <!-- Price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_ticket"
                    app:tint="@color/purple_main"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/dm_sans" />
            </LinearLayout>

            <!-- Action buttons (View, Remove, RSVP) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnViewEvent"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="View"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/dm_sans"
                    android:background="@drawable/btn_secondary"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnRemoveFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="♥ Remove"
                    android:textSize="12sp"
                    android:textColor="@color/pink_accent"
                    android:fontFamily="@font/dm_sans"
                    android:background="@drawable/btn_ghost"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnRsvpNow"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="RSVP Now"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/dm_sans"
                    android:background="@drawable/btn_gradient"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
