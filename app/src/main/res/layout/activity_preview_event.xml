<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- ── Hero Section ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <!-- Hero image -->
        <ImageView
            android:id="@+id/ivCoverPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Event cover photo" />

        <!-- Gradient overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_gradient_overlay" />

        <!-- Top row: Back button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="← Back"
                android:textColor="#F0EEFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:background="@drawable/btn_back_bg"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Bottom: format badge + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_pill_purple"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:text="In-Person" />

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/syne_bold"
                android:lineSpacingExtra="4dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:breakStrategy="balanced"
                android:text="Event Title" />
        </LinearLayout>
    </FrameLayout>

    <!-- ── Content Scroll View ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbarStyle="outsideOverlay"
        android:paddingBottom="70dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Date + Time row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <!-- Date card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_dark_bg"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_calendar"
                        android:contentDescription="Date"
                        android:layout_marginEnd="12dp"
                        app:tint="#9D5FF5" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textColor="#8882AA"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvDateStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#F0EEFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:text="Not set" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Time card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_dark_bg"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_clock"
                        android:contentDescription="Time"
                        android:layout_marginEnd="12dp"
                        app:tint="#9D5FF5" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time"
                            android:textColor="#8882AA"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvTimeStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#F0EEFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:text="Not set" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Location card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_dark_bg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_location"
                    android:contentDescription="Location"
                    android:layout_marginEnd="12dp"
                    app:tint="#9D5FF5" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textColor="#8882AA"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F0EEFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="Not set" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stats row (Price / Attending / Format / Capacity) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="12dp">

                <!-- Price -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_dark_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="3dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_ticket"
                        android:contentDescription="Price"
                        android:layout_marginBottom="4dp"
                        app:tint="#9D5FF5" />

                    <TextView
                        android:id="@+id/tvStatPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F0EEFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:text="Free" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price"
                        android:textColor="#8882AA"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Attending -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_dark_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_users"
                        android:contentDescription="Attending"
                        android:layout_marginBottom="4dp"
                        app:tint="#9D5FF5" />

                    <TextView
                        android:id="@+id/tvStatAttending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F0EEFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attending"
                        android:textColor="#8882AA"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Format -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_dark_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_tag"
                        android:contentDescription="Format"
                        android:layout_marginBottom="4dp"
                        app:tint="#9D5FF5" />

                    <TextView
                        android:id="@+id/tvStatFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#F0EEFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="—" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Format"
                        android:textColor="#8882AA"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Capacity -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_dark_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginStart="3dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_users"
                        android:contentDescription="Capacity"
                        android:layout_marginBottom="4dp"
                        app:tint="#9D5FF5" />

                    <TextView
                        android:id="@+id/tvStatCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F0EEFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"
                        android:text="—" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capacity"
                        android:textColor="#8882AA"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Seating card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_dark_bg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_seat"
                    android:contentDescription="Seating"
                    android:layout_marginEnd="12dp"
                    app:tint="#9D5FF5" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seating"
                        android:textColor="#8882AA"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvSeatingType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F0EEFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <!-- About section -->
            <TextView
                android:id="@+id/tvAboutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About This Event"
                android:textColor="#F0EEFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/syne_bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_dark_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvAboutDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B8B4D9"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="No description provided." />
            </LinearLayout>

            <!-- Hosted By section -->
            <LinearLayout
                android:id="@+id/hostedByCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_dark_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hosted By"
                    android:textColor="#F0EEFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <!-- Avatar -->
                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/avatar_gradient_bg"
                        android:clipToOutline="true">

                        <TextView
                            android:id="@+id/tvHostInitials"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:text="HO" />
                        
                        <ImageView
                            android:id="@+id/ivHostProfilePhoto"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvHostName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#F0EEFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp"
                                android:text="Host Name" />

                            <!-- Verified badge -->
                            <TextView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/verified_badge_bg"
                                android:gravity="center"
                                android:text="✓"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Event Organizer"
                            android:textColor="#8882AA"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHostEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8882AA"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp"
                    android:text="host@example.com" />

                <Button
                    android:id="@+id/btnMessageHost"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Message Host"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/btn_gradient_bg"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom Action Buttons ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:background="@color/bg_dark"
        android:weightSum="2">

        <Button
            android:id="@+id/btnSaveDraft"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Save Draft"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/bg_card"
            android:layout_marginEnd="10dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnPublish"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Publish"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/purple_main"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

</LinearLayout>