<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outermost soft glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AB57BEE"/>
            <corners android:radius="22dp"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    <!-- Mid glow -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#30B57BEE"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Inner tight glow -->
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#50B57BEE"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>