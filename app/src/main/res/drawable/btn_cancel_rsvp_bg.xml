<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Very subtle red fill — matches the semi-transparent pattern -->
    <solid android:color="#1AF87171" />

    <!-- Stroke gives it definition on dark bg without looking muddy -->
    <stroke
        android:width="1dp"
        android:color="#4DF87171" />

    <corners android:radius="12dp" />
</shape>